{
  "name": "storykit-github-auth-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "demo": "node --disable-warning=ExperimentalWarning tools/demo-server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "configure:github": "node tools/configure-github.mjs",
    "deploy": "wrangler deploy",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/auth.js && node --check tools/configure-github.mjs"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4"
  }
}
